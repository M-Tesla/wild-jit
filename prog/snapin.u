use lib.unison_base_7_20_0

structural ability Choose where
  choose : {Choose} Boolean

structural ability State s where
  get : {State s} s
  put : s ->{State s} ()

runChoose : Request {Choose} Nat -> Nat
runChoose = cases
  { Choose.choose -> k } ->
    left = handle k true with runChoose
    right = handle k false with runChoose
    left Nat.+ right
  { n } -> n

stateHandler : Nat -> Request {State Nat} Nat -> Nat
stateHandler s = cases
  { State.get -> k } -> handle k s with stateHandler s
  { State.put s2 -> k } -> handle k () with stateHandler s2
  { a } -> a

main : '{IO, Exception} ()
main = do
  n = handle
    handle
      b = Choose.choose
      if b then
        State.put 9
        1
      else State.get
    with stateHandler 0
  with runChoose
  printLine (Nat.toText n)
