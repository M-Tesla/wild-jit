use lib.unison_base_7_20_0

structural ability Abort where
  abort : {Abort} Nat

runAbort : Request {Abort} Nat -> Nat
runAbort = cases
  { Abort.abort -> k } -> 0
  { n } -> n

main : '{IO, Exception} ()
main = do
  n = handle
    x = Abort.abort
    x Nat.+ 1
  with runAbort
  printLine (Nat.toText n)
