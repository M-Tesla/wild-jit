use lib.unison_base_7_20_0

structural ability Choose where
  choose : {Choose} Boolean

runChoose : Request {Choose} Nat -> Nat
runChoose = cases
  { Choose.choose -> k } ->
    left = handle k true with runChoose
    right = handle k false with runChoose
    left Nat.+ right
  { n } -> n

main : '{IO, Exception} ()
main = do
  printLine (Nat.toText 1)
  n = handle
    printLine (Nat.toText 2)
    b = Choose.choose
    if b then
      printLine (Nat.toText 3)
      10
    else
      printLine (Nat.toText 4)
      1
  with runChoose
  printLine (Nat.toText n)
